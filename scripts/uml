#!/bin/zsh
# Loader for this project. Written by get-uml-viewer.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

# get-uml-viewer replaces the placeholder with this checkout's deps.
DEPS='__DEPS_LINE__'

edn_path() {
  local name base f
  name="$(basename "$ROOT")"
  if [[ -f "examples/${name}.edn" ]]; then
    echo "examples/${name}.edn"
    return
  fi
  if [[ -d examples ]]; then
    for f in examples/*.edn(N); do
      [[ -f "$f" ]] || continue
      base="${f:t}"
      [[ "$base" == *.policy.edn ]] && continue
      echo "$f"
      return
    done
  fi
}

policy_path() {
  local name f
  name="$(basename "$ROOT")"
  if [[ -f "examples/${name}.policy.edn" ]]; then
    echo "examples/${name}.policy.edn"
    return
  fi
  for f in examples/*.policy.edn(N) policy.edn(N); do
    echo "$f"
    return
  done
}

LOG="uml-viewer-log.txt"

launch_viewer() {
  {
    printf '----- %s starting uml-viewer' "$(date '+%Y-%m-%d %H:%M:%S')"
    [[ $# -gt 0 ]] && printf ' %s' "$@"
    printf '\n'
  } >> "$LOG"
  # `clj` is rlwrap on Homebrew; a background rlwrap stops (SIGTTOU) and
  # never starts the JVM. `clojure` is the same CLI without the tty wrapper.
  nohup clojure -Sdeps "$DEPS" -M -m uml-viewer.main.uml-viewer "$@" >> "$LOG" 2>&1 </dev/null &
  disown
  echo "UML viewer started (pid $!). Log: $LOG"
}

# A Clojure project uses its own :crap / :mutate aliases. Any other project
# uses the crapper or mutator checkout get-uml-viewer cloned beside uml-viewer.
run_metric() {
  local alias="$1" tool="$2"
  shift 2
  if [[ -f deps.edn ]]; then
    exec clojure "-M:${alias}" "$@"
  fi
  local bin=".uml-viewer/${tool}/${tool}"
  if [[ ! -x "$bin" ]]; then
    local var="${(U)tool}_REPO_URL"
    echo "uml: ${bin} is missing. Re-run get-uml-viewer (set ${var} if the clone failed)." >&2
    exit 1
  fi
  exec "$bin" "$@"
}

case "${1:-}" in
  -h|--help)
    echo "usage: ./uml [--restart | ir | crap | mutate] [args]" >&2
    echo "  (no args)   fresh window; companion writes the diagram" >&2
    echo "  --restart   new JVM, same companion; restores last view" >&2
    echo "  ir          regenerate the IR from this project's policy" >&2
    echo "  crap        CRAP snapshot (.metrics/crap.edn) for the whole tree" >&2
    echo "  mutate F…   differential mutation testing of the given files" >&2
    echo "  The viewer detaches; exceptions go to $LOG." >&2
    exit 0
    ;;
  --restart)
    edn="$(edn_path)"
    if [[ -n "$edn" ]]; then
      launch_viewer --restart "$edn"
    else
      launch_viewer --restart
    fi
    exit 0
    ;;
  ir)
    shift
    policy="$(policy_path)"
    if [[ -z "$policy" ]]; then
      echo "uml: no policy. Write examples/$(basename "$ROOT").policy.edn." >&2
      exit 1
    fi
    exec clojure -Sdeps "$DEPS" -M -m uml-viewer.main.ir-generator "$policy" "$@"
    ;;
  crap)
    shift
    run_metric crap crapper "$@"
    ;;
  mutate)
    shift
    run_metric mutate mutator "$@"
    ;;
esac

launch_viewer "$@"
